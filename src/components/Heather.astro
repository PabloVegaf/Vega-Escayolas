---
import Logo from '../assets/Logo Vega Escayolas.png';
import background from '../assets/background.svg';
---

<div class="heather">
    <img src={Logo.src} alt="Logo Vega Escayolas">
    <div id="enlaces">
        <a href="#">Sobre nosotros</a>
        <a href="#">Servicios</a>
        <a href="#">Proyectos</a>
        <div id="contacto">
            <a href="">Contacto</a>
        </div>
    </div>
        
</div>

<style>
    .heather{
        height: 5rem;
        max-width: 100%;
        display: flex;
        justify-content: space-between;
        padding-left: 2rem;
        padding-right: 2rem;
        overflow: hidden; /* Evita que el fondo se desborde */
        background-color: #F9FBFD;
        border-bottom: solid 1px #E0E0E0;
    }
    img{
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }
    #enlaces{
        display: flex;
        align-items: center;
        gap: 2rem;
        font-weight: bold;
    }
    #enlaces a{
        text-decoration: none;
        color: #000016;
    }
    #enlaces a:hover, #contacto:hover{
        transform:scale(1.06); /* aumenta ligeramente el tamaño del enlace */
    }
    #enlaces a, #contacto{
        transition: transform 0.25s ease-out; /* Transforma la propiedad a animar (transform en este caso), ease-out hace que el movimiento empiece rapido y termine lento. */
    }
    #contacto{
        background-color: #8BC34A;
        border-radius: 25px;
        padding: 0.5rem 1rem;
        
    }
    #contacto a{
        color: white;
    }

</style>