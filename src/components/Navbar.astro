---
import Logo from '../assets/Logo Vega Escayolas.png';
---

<div class="header">
    <img src={Logo.src} alt="Logo Vega Escayolas">
    <div id="enlaces">
        <a href="#sobre-nosotros">Sobre nosotros</a>
        <a href="#servicios">Servicios</a>
        <a href="#proyectos">Proyectos</a>
        <div id="boton-contacto">
            <a href="#contacto">Contacto</a>
        </div>
    </div>
        
</div>

<style>
    .header{
    height: 5rem;
    max-width: 100%;
    display: flex;
    justify-content: space-between;
    padding-left: 2rem;
    padding-right: 2rem;
    background-color: #f9fafd;
    border-radius: 0.9rem;
    margin: 1rem;
    }

    img{
        max-width: 100%;
        height: auto;
        object-fit: contain;
    }
    #enlaces{
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    row-gap: 0.25rem;
    font-size: 0.95rem;
    max-width: 100%;
    font-weight: bold;
    }

    #enlaces a{
        text-decoration: none;
        color: #000016;
    }
    #enlaces a:hover, #boton-contacto:hover{
        transform:scale(1.06); /* aumenta ligeramente el tamaño del enlace */
    }
    #enlaces a, #boton-contacto{
        transition: transform 0.25s ease-out; /* Transforma la propiedad a animator (transform en este caso), ease-out hace que el movimiento empiece rapido y termine lento. */
    }
    #boton-contacto{
        background-color: #8BC34A;
        border-radius: 25px;
        padding: 0.5rem 1rem;
        
    }
    #boton-contacto a{
        color: white;
    }
    #enlaces a, #contacto{
        transition: transform 0.25s ease-out; /* Transforma la propiedad a animar (transform en este caso), ease-out hace que el movimiento empiece rapido y termine lento. */
    }
    #contacto{
        background-color: #8BC34A;
        border-radius: 25px;
        padding: 0.5rem 1rem;
        
    }
    #contacto a{
        color: white;
    }

</style>