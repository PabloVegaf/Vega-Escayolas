---
import Antes1 from '../assets/Antes1.jpg';
import Antes2 from '../assets/Antes2.jpg';
import Antes3 from '../assets/Antes3.jpg';
import Despues1 from '../assets/Despues1.jpg';
import Despues2 from '../assets/Despues2.jpg';
import Despues3 from '../assets/Despues3.jpg';

const trabajos = [
    {
        titulo: 'Reforma de Vivienda',
        descripcion: 'Instalación completa de techos y tabiquería en pladur para una vivienda moderna y funcional.',
        imagenAntes: Antes1,
        imagenDespues: Despues1,
        altAntes: 'Estado previo de la reforma de vivienda',
        altDespues: 'Resultado final de la reforma de vivienda',
        posicionAntes: 'center center',
        posicionDespues: 'center center',
    },
    {
        titulo: 'Oficinas Corporativas',
        descripcion: 'Aislamiento térmico y acústico con perlita, más alisado de techos para un entorno profesional.',
        imagenAntes: Antes2,
        imagenDespues: Despues2,
        altAntes: 'Estado previo de las oficinas corporativas',
        altDespues: 'Resultado final de las oficinas corporativas',
        posicionAntes: 'center center',
        posicionDespues: 'center center',
    },
    {
        titulo: 'Decoración Clásica',
        descripcion: 'Molduras de escayola artesanales que aportan elegancia y distinción a cualquier espacio.',
        imagenAntes: Antes3,
        imagenDespues: Despues3,
        altAntes: 'Estado previo del espacio con decoración clásica',
        altDespues: 'Resultado final del espacio con decoración clásica',
        posicionAntes: 'center center',
        posicionDespues: 'center center',
    },
];
---

<div class="trabajos_container">
    <div class="trabajos_encabezado">
        <p class="subtitulo">PORTFOLIO</p>
        <h2 class="titulo">Algunos de Nuestros Trabajos</h2>
    </div>
    <div class="trabajos_grid">
        {trabajos.map((trabajo) => (
            <div class="tarjeta">
                <div class="tarjeta_imagen">
                    <img
                        class="imagen_comparativa imagen_antes"
                        src={trabajo.imagenAntes.src}
                        alt={trabajo.altAntes}
                        style={`object-position: ${trabajo.posicionAntes};`}
                    />
                    <img
                        class="imagen_comparativa imagen_despues"
                        src={trabajo.imagenDespues.src}
                        alt={trabajo.altDespues}
                        style={`object-position: ${trabajo.posicionDespues};`}
                    />
                    <span class="etiqueta etiqueta_antes">Antes</span>
                    <span class="etiqueta etiqueta_despues">Después</span>
                </div>
                <div class="tarjeta_contenido">
                    <h3>{trabajo.titulo}</h3>
                    <p>{trabajo.descripcion}</p>
                </div>
            </div>
        ))}
    </div>
</div>

<style>
    .trabajos_container {
        width: 90%;
        margin: 0 auto;
        padding: 3rem 2rem;
        background-color: #f9fafd;
        margin-bottom: 3rem;
        border-radius: 0.9rem;
    }

    .trabajos_encabezado {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .subtitulo {
        color: #8BC34A;
        font-weight: bold;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.1em;
    }

    .titulo {
        font-size: 2rem;
        color: #1f283a;
        font-weight: bold;
    }

    .trabajos_grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .tarjeta {
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .tarjeta:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .tarjeta_imagen {
        position: relative;
        width: 100%;
        height: 15.6rem;
        overflow: hidden;
        isolation: isolate;
        background-color: #eef2f7;
    }

    .tarjeta_imagen::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top right,
            transparent calc(50% - 1px),
            rgba(255, 255, 255, 0.85) 50%,
            transparent calc(50% + 1px)
        );
        pointer-events: none;
        z-index: 2;
    }

    .imagen_comparativa {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .imagen_antes {
        clip-path: polygon(0 0, 0 100%, 100% 0);
    }

    .imagen_despues {
        clip-path: polygon(100% 0, 100% 100%, 0 100%);
    }

    .etiqueta {
        position: absolute;
        z-index: 3;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        background-color: rgba(31, 40, 58, 0.72);
        color: white;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        backdrop-filter: blur(4px);
    }

    .etiqueta_antes {
        top: 1rem;
        left: 1rem;
    }

    .etiqueta_despues {
        right: 1rem;
        bottom: 1rem;
    }

    .tarjeta_contenido {
        padding: 1.5rem;
    }

    .tarjeta_contenido h3 {
        font-size: 1.1rem;
        color: #1f283a;
        margin-bottom: 0.5rem;
        font-weight: bold;
    }

    .tarjeta_contenido p {
        color: #666;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    @media (max-width: 64em) {
        .trabajos_grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 48em) {
        .trabajos_grid {
            grid-template-columns: 1fr;
        }

        .trabajos_container {
            padding: 2rem 1rem;
        }

        .titulo {
            font-size: 1.5rem;
        }

        .tarjeta_imagen {
            height: 14.5rem;
        }
    }
</style>
