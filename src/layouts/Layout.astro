---
import Navbar from "../components/Navbar.astro";
import Header from "../components/Header.astro";
import Sobre_nosotros from "../components/Sobre_nosotros.astro";
import Nuestros_servicios from "../components/Nuestros_servicios.astro";
import Trabajos from "../components/Trabajos.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO primario -->
        <title>
            Vega Escayolas | Escayola, Pladur y Perlita en El Puerto de Santa
            María
        </title>
        <meta
            name="description"
            content="Vega Escayolas: expertos en escayola, pladur y perlita en El Puerto de Santa María, Cádiz. Reformas, tabiques, falsos techos y aislamientos de calidad. ¡Pide presupuesto sin compromiso!"
        />
        <meta
            name="keywords"
            content="escayola, pladur, perlita, reformas, tabiques, falsos techos, aislamiento, construcción, El Puerto de Santa María, Cádiz, Jerez, Chiclana, Bahía de Cádiz"
        />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="https://vegaescayolas.es" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://vegaescayolas.es" />
        <meta
            property="og:title"
            content="Vega Escayolas | Escayola, Pladur y Perlita en El Puerto de Santa María"
        />
        <meta
            property="og:description"
            content="Expertos en escayola, pladur y perlita. Reformas, tabiques, falsos techos y aislamientos de calidad en El Puerto de Santa María, Cádiz."
        />
        <meta
            property="og:image"
            content="https://vegaescayolas.es/android-chrome-192x192.png"
        />
        <meta property="og:locale" content="es_ES" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta
            name="twitter:title"
            content="Vega Escayolas | Escayola, Pladur y Perlita en El Puerto de Santa María"
        />
        <meta
            name="twitter:description"
            content="Expertos en escayola, pladur y perlita. Reformas, tabiques, falsos techos y aislamientos de calidad en El Puerto de Santa María, Cádiz."
        />
        <meta
            name="twitter:image"
            content="https://vegaescayolas.es/android-chrome-192x192.png"
        />

        <!-- Favicon -->
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="192x192"
            href="/android-chrome-192x192.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />

        <!-- Structured data: LocalBusiness -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "HomeAndConstructionBusiness",
                "name": "Vega Escayolas",
                "description": "Expertos en escayola, pladur y perlita en El Puerto de Santa María. Reformas, tabiques, falsos techos y aislamientos.",
                "url": "https://vegaescayolas.es",
                "telephone": ["+34 727 714 872", "+34 670 684 394"],
                "email": "vegaescayolas@gmail.com",
                "areaServed": {
                    "@type": "City",
                    "name": "El Puerto de Santa María"
                },
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": "El Puerto de Santa María",
                    "addressRegion": "Cádiz",
                    "addressCountry": "ES"
                },
                "sameAs": [
                    "https://www.facebook.com/profile.php?id=61555620961917"
                ]
            }
        </script>
    </head>
    <body>
            <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
            <header>
                <Navbar />
                <Header />
            </header>
            <main id="main-content">
                <slot />
                <section id="sobre-nosotros" aria-labelledby="sobre-nosotros-titulo"><Sobre_nosotros /></section>
                <section id="servicios" aria-labelledby="servicios-titulo"><Nuestros_servicios /></section>
                <section id="proyectos" aria-labelledby="proyectos-titulo"><Trabajos /></section>
            </main>
            <footer>
                <Contacto />
                <Footer />
            </footer>
        </body>
</html>

<style>
    *,
    *::before,
    *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    html,
    body {
        width: 100%;
        height: 100%;
    }

    /* Scroll suave solo si el usuario no prefiere movimiento reducido */
    @media (prefers-reduced-motion: no-preference) {
        html {
            scroll-behavior: smooth;
        }
    }

    /* Respetar preferencias de movimiento reducido */
    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
    }

    /* --- Skip link --- */
    .skip-link {
        position: absolute;
        top: -100%;
        left: 0.5rem;
        background-color: #1F283A;
        color: #FFFFFF;
        padding: 0.75rem 1.5rem;
        border-radius: 0 0 0.5rem 0.5rem;
        z-index: 10000;
        font-weight: bold;
        text-decoration: none;
        font-size: 1rem;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .skip-link:focus {
        top: 0;
    }

    /* --- Estilos de foco visibles globales --- */
    :focus-visible {
        outline: 3px solid #8BC34A;
        outline-offset: 2px;
        border-radius: 2px;
    }

    .skip-link:focus-visible {
        outline-color: #FFFFFF;
    }
</style>
